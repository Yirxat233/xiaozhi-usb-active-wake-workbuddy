BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
XIAOZHI_NOTIFIER=mock
XIAOZHI_USB_PORT=COM5
XIAOZHI_MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN
XIAOZHI_MCP_CREDENTIAL_FILE=./data/xiaozhi-mcp.dpapi
XIAOZHI_MCP_RECONNECT_INITIAL_MS=1000
XIAOZHI_MCP_RECONNECT_MAX_MS=60000
MOCK_STEP_DELAY_MS=250
WORKBUDDY_ADAPTER=mock
WORKBUDDY_CWD=C:/path/to/workbuddy/project
WORKBUDDY_PROJECT_ROOTS=C:/Users/you/WorkBuddy
WORKBUDDY_CONFIG_DIR=C:/Users/you/.workbuddy
WORKBUDDY_SESSION_ROOT=C:/Users/you/.workbuddy/projects
WORKBUDDY_STATE_FILE=./data/workbuddy-state.json
NOTIFICATION_QUEUE_FILE=./data/notification-queue.json
WORKBUDDY_TRANSPORT=desktop
WORKBUDDY_DESKTOP_TIMEOUT_MS=600000
CODEBUDDY_CLI_SCRIPT=C:/Users/you/AppData/Local/Programs/WorkBuddy/resources/app.asar.unpacked/cli/dist/codebuddy.js
WORKBUDDY_PERMISSION_MODE=default
WORKBUDDY_TOOLS=default
WORKBUDDY_MAX_TURNS=8
